# Copy to env.local and edit for your environment:
#   cp env.example env.local
#   source env.local

# Directory containing Markdown knowledge files (absolute or relative to repo root)
MARKDOWN_SOURCE_DIR="./byok/knowledgebase"

# Local directory where the RAG tool writes byok-image.tar
OUTPUT_DIR="./byok/output"

# Full image reference to push and reference in OLSConfig
# Examples:
#   default-route-openshift-image-registry.apps.cluster.example.com/openshift-lightspeed/byok-image:latest
#   quay.io/<username>/byok-image:latest
BYOK_IMAGE="default-route-openshift-image-registry.apps.example.com/openshift-lightspeed/byok-image:latest"

# OpenShift internal registry route (set in step 3 of the BYOK lab)
OCP_REGISTRY_URL="default-route-openshift-image-registry.apps.example.com"

# Namespace where LightSpeed runs and where the BYOK image is pushed
OLS_NAMESPACE="openshift-lightspeed"

# OLSConfig resource name
OLS_CONFIG_NAME="cluster"

# RAG index settings (defaults from the RAG tool output)
RAG_INDEX_ID="vector_db_index"
RAG_INDEX_PATH="/rag/vector_db"
